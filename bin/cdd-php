#!/usr/bin/env php
<?php

/**
 * CDD-PHP (Compiler Driven Development) CLI
 * No external dependencies.
 */

declare(strict_types=1);

namespace Cdd;

$baseDir = dirname(__DIR__);

if (!defined('STDIN')) {
    define('STDIN', @fopen('php://stdin', 'r'));
}
if (!defined('STDOUT')) {
    define('STDOUT', @fopen('php://stdout', 'w'));
}
if (!defined('STDERR')) {
    define('STDERR', @fopen('php://stderr', 'w'));
}

if (file_exists("$baseDir/vendor/autoload.php")) {
    require_once "$baseDir/vendor/autoload.php";
}

// Simple autoloader for src directory
spl_autoload_register(function ($class) use ($baseDir) {
    if (strpos($class, 'Cdd\\') === 0) {
        $relative = substr($class, 4);
        $path = explode('\\', $relative);
        $file = $baseDir . '/src/' . strtolower($path[0]) . '/';
        if (count($path) > 1) {
            $file .= implode('/', array_slice($path, 1)) . '.php';
        } else {
            $file .= 'parse.php';
        }

        if (file_exists($file)) {
            require_once $file;
            return;
        }

        $emitFile = "$baseDir/src/" . strtolower($path[0]) . "/emit.php";
        if (file_exists($emitFile)) {
            require_once $emitFile;
            return;
        }

        // Check CddCli
        if ($class === 'Cdd\\Cli\\CddCli') {
            require_once "$baseDir/src/cli/CddCli.php";
        }
    }
});

// Require all functional scripts since PHP cannot autoload functions
$dirs = ['functions', 'classes', 'docstrings', 'routes', 'tests', 'mocks', 'openapi', 'client', 'cli', 'schemas', 'components', 'parameters', 'request_bodies', 'responses', 'operations', 'paths', 'servers', 'security', 'info', 'encoding', 'webhooks', 'controllers'];
foreach ($dirs as $dir) {
    $parseFile = "$baseDir/src/$dir/parse.php";
    $emitFile = "$baseDir/src/$dir/emit.php";
    if (file_exists($parseFile)) {
        require_once $parseFile;
    }
    if (file_exists($emitFile)) {
        require_once $emitFile;
    }
}
if (file_exists("$baseDir/src/openapi/resolve_refs.php")) {
    require_once "$baseDir/src/openapi/resolve_refs.php";
}

$sapi = php_sapi_name();
$isCli = $sapi === 'cli' || $sapi === 'cgi-fcgi' || $sapi === 'cgi';
if ($isCli && isset($argv) && count($argv) > 0 && basename(__FILE__) === basename($argv[0])) {
    exit(\Cdd\Cli\CddCli::run($argv));
}
